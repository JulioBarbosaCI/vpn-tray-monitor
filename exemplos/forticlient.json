{
  "displayName": "VPN Empresa (FortiClient)",
  "checkIntervalSeconds": 60,
  "failuresBeforeReconnect": 2,
  "notifyOnChange": true,
  "startWithWindows": true,

  "check": {
    "kind": "interface",
    "interfaceMatch": "Fortinet"
  },
  "connect": {
    "kind": "command",
    "command": "C:\\Program Files\\Fortinet\\FortiClient\\FortiSSLVPNclient.exe",
    "args": ["connect", "-h", "vpn.empresa.com.br:10443", "-u", "USUARIO"]
  }
}
