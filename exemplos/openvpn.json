{
  "displayName": "VPN Empresa (OpenVPN)",
  "checkIntervalSeconds": 30,
  "failuresBeforeReconnect": 2,
  "notifyOnChange": true,
  "startWithWindows": true,

  "check": {
    "kind": "interface",
    "interfaceMatch": "TAP-Windows"
  },
  "connect": {
    "kind": "openvpn",
    "profile": "empresa",
    "command": "C:\\Program Files\\OpenVPN\\bin\\openvpn-gui.exe",
    "args": ["--connect", "empresa.ovpn"]
  }
}
